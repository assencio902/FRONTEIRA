<?xml version="1.0" encoding="utf-8"?>
<!--
  Permite tráfego HTTP (cleartext) em qualquer host durante o desenvolvimento.
  Em produção, remova a entrada <domain-config> ou use HTTPS.

  COMO USAR:
  1. Coloque este arquivo em:
     android/app/src/main/res/xml/network_security_config.xml

  2. No arquivo android/app/src/main/AndroidManifest.xml, dentro de <application>:
     android:networkSecurityConfig="@xml/network_security_config"
     android:usesCleartextTraffic="true"

  Exemplo de <application> no AndroidManifest.xml:
  <application
      android:networkSecurityConfig="@xml/network_security_config"
      android:usesCleartextTraffic="true"
      ...
  >
-->
<network-security-config>
  <base-config cleartextTrafficPermitted="true">
    <trust-anchors>
      <certificates src="system" />
    </trust-anchors>
  </base-config>
</network-security-config>
