# ============================================================
# .env.example - copie para .env e ajuste os valores
# ============================================================

# -- PostgreSQL ------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=monitor
POSTGRES_USER=monitor_user
POSTGRES_PASSWORD=troque-por-uma-senha-forte

# -- Redis -----------------------------------------------------
REDIS_URL=redis://redis:6379/0

# -- Auth / JWT ------------------------------------------------
# Gere um segredo forte:
# python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=troque-por-um-segredo-com-pelo-menos-32-caracteres
JWT_EXPIRE_HOURS=8
JWT_REFRESH_EXPIRE_DAYS=30

# -- Usuario admin bootstrap ----------------------------------
# Criado automaticamente na primeira inicializacao do banco.
# Se o usuario ja existir, estas variaveis nao tem efeito.
ADMIN_USER=admin
ADMIN_PASSWORD=troque-por-uma-senha-admin-forte

# -- Retencao / Cleanup ----------------------------------------
CLEANUP_ENABLED=true
CLEANUP_INTERVAL_SECONDS=600
CLEANUP_DRY_RUN=false
RETENTION_DAYS_IMAGES=7
RETENTION_DAYS_EVENTS=30
MAX_UPLOADS_GB=50
UPLOADS_DIR=/app/uploads
ABORDADO_IMAGES_DIR=/app/abordados

# -- Webhook hardening (limites para evitar estouro de RAM) ----
# Tamanho maximo do body aceito no /webhook e /api/simple-webhook (bytes).
WEBHOOK_MAX_BODY_BYTES=8388608
# Se true, rejeita requests sem Content-Length.
WEBHOOK_REQUIRE_CONTENT_LENGTH=false

# -- LPR -------------------------------------------------------
MIN_LPR_CONFIDENCE=0.40

# -- YOLO Worker ----------------------------------------------
YOLO_MODEL=yolov8n.pt
YOLO_CONF=0.35
PICKUP_MAX_HEIGHT_FRAC=0.45
PICKUP_MAX_AREA_FRAC=0.28

# -- FCM -------------------------------------------------------
FCM_PROJECT_ID=bpfron
