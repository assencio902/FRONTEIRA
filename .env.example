# ============================================================
# .env.example — copie para .env e ajuste os valores
# ============================================================

# ── PostgreSQL ───────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=monitor
POSTGRES_USER=monitor_user
POSTGRES_PASSWORD=monitor_pass

# ── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Auth / JWT ───────────────────────────────────────────────
# Gere um segredo forte: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=bpfron-change-me-in-production
JWT_EXPIRE_HOURS=8          # duração do token (equivale a JWT_EXPIRE_MINUTES * 60)

# ── Usuário admin inicial ────────────────────────────────────
# Criado automaticamente na primeira inicialização do banco.
# Se o usuário já existir, estas variáveis não têm efeito.
ADMIN_USER=admin
ADMIN_PASSWORD=admin123

# ── Retenção / Cleanup ───────────────────────────────────────
CLEANUP_ENABLED=true
CLEANUP_INTERVAL_SECONDS=600
CLEANUP_DRY_RUN=false
RETENTION_DAYS_IMAGES=7
RETENTION_DAYS_EVENTS=30
MAX_UPLOADS_GB=50
UPLOADS_DIR=/app/uploads

# ── Confiança mínima LPR ─────────────────────────────────────
MIN_LPR_CONFIDENCE=0.40

# ── YOLO Worker ──────────────────────────────────────────────
YOLO_MODEL=yolov8n.pt
YOLO_CONF=0.35
